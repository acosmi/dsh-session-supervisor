{
  "name": "dsh-session-supervisor",
  "version": "0.1.0-beta.0",
  "description": "A durable, bounded lifecycle supervisor with scheduled evaluation for live DeepSeek Harness sessions",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "test:loader": "vitest run tests/loader.spec.ts",
    "test:profile-install": "node scripts/profile-install-smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "private": true,
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@vitest/coverage-v8": "^3.0.0",
    "publint": "^0.3.23",
    "tsdown": "^0.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<publisher>/dsh-session-supervisor.git"
  },
  "homepage": "https://github.com/<publisher>/dsh-session-supervisor#readme",
  "bugs": {
    "url": "https://github.com/<publisher>/dsh-session-supervisor/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "supervisor",
    "agent",
    "session",
    "durable",
    "incident"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
